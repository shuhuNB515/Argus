#!/bin/sh
set -u

app_root=$(CDPATH= cd -- "$(dirname "$0")/../.." && pwd)
binary="$app_root/Contents/MacOS/Argus-bin"
child=0
stop() {
	if [ "$child" -ne 0 ]; then
		kill -TERM "$child" 2>/dev/null || true
		wait "$child" 2>/dev/null || true
	fi
	exit 0
}
trap stop INT TERM
"$binary" "$@" &
child=$!
wait "$child"
code=$?
if [ "$code" -ne 0 ]; then
	log_path="${ARGUS_HOME:-$HOME/Library/Application Support/Argus}/startup.log"
	/usr/bin/osascript - "$log_path" <<'APPLESCRIPT'
on run argv
  display alert "Argus 启动失败" message ("请查看启动日志：" & item 1 of argv) as critical
end run
APPLESCRIPT
fi
exit "$code"
