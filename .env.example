# Argus 可选设置。普通桌面用户不需要创建此文件或配置数据库。
# Docker 用户可以直接执行 docker compose up -d，无需先复制 .env。
ARGUS_TAG=latest
ARGUS_BIND=127.0.0.1
ARGUS_HTTP_PORT=8787
# 默认只通过本机访问。若主动开放远程访问，请改为 required 并设置管理员密码。
ARGUS_AUTH_MODE=disabled
ARGUS_ADMIN_PASSWORD=
ARGUS_SETUP_TOKEN=
ARGUS_CORS_ORIGINS=
ARGUS_LANG=zh

# 模型配置也可以在应用内填写；不要将自己的密钥提交到 Git。
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ARGUS_LLM_PROVIDER=
ARGUS_LLM_MODEL=
ARGUS_LLM_BASE_URL=
ARGUS_LLM_PROXY=

# 高级选项：普通用户留空，程序自动选择用户数据目录和内置数据库。
# ARGUS_HOME=/path/to/Argus
# ARGUS_PG_DSN=postgres://user:password@localhost:5432/argus?sslmode=disable
