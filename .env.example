# Docker 部署设置 (复制此文件 .env 做到这一点)
# ARGUS_TAG 是 docker-compose 您收到的图像 ghcr.io/shuhuNB515/Argus 是一个标签.
# latest 指向最新版本。, To pin to a specific release v* 写下标签.
ARGUS_TAG=latest
POSTGRES_USER=argus
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=argus
# 本地源码运行时，PostgreSQL 只在回环地址开放此端口。
ARGUS_PG_PORT=5433

# LLM (输入一项或两项. 稍后将其留空 UI 您可以将其设置为)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ARGUS_LLM_PROVIDER=
ARGUS_LLM_MODEL=
ARGUS_LLM_BASE_URL=
ARGUS_LLM_PROXY=

# 首次运行保护 (防止远程抢占管理员帐户)
# - 网络/API 端口默认为主机的 127.0.0.1 只会发布于. 直接从另一台设备
#   如果您需要连接 ARGUS_BIND=0.0.0.0 将其更改为, 请先完成初始设置.
# - 首次启动时，日志中会记录一个随机设置令牌。(docker compose logs argus),
#   /setup 您必须在屏幕上输入该值才能创建管理员密码。.
#   ARGUS_SETUP_TOKEN 如果指定，该值将成为令牌并且不会记录在日志中。.
# - ARGUS_ADMIN_PASSWORD 如果您指定 /setup 立即初始化为该值，无需任何(8现在就这样了).
ARGUS_BIND=127.0.0.1
# Authentication mode: auto = off for loopback desktop installs, on for remote binds;
# required = always on; disabled = explicitly off (only use on a trusted local machine).
ARGUS_AUTH_MODE=auto
ARGUS_SETUP_TOKEN=
ARGUS_ADMIN_PASSWORD=
# 跨浏览器起源(CORS) 白名单(逗号分隔). 内置 UI 留空，因为它是相同的来源。.
ARGUS_CORS_ORIGINS=

# 服务器端默认输出语言(en·ko·zh·es·ja). 如果为空，则为英文.
# - 代理报告·总结·这成为对话响应和服务器错误消息的默认设置。, 在设置屏幕上
#   "显示语言"如果您选择 ，则该值优先。.
# - 服务器控制台日志仅遵循该值(无论设置屏幕选择如何).
# - 网页屏幕文本的语言是在每个浏览器的设置屏幕上选择的。(基础英语).
ARGUS_LANG=
